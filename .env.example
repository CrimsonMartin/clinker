# Citation Linker build configuration - example template
# Copy this file to .env and adjust. Every value is optional; without a .env
# the build uses the defaults shown here.

# Base URL of the self-hosted Clinker sync API (see docs/API.md).
# The packaged extension's host_permissions are generated from this origin.
API_BASE_URL=https://clinker.lanerate.io

# Donation link shown in the sidebar
DONATION_URL=https://www.buymeacoffee.com/YOUR_USERNAME
